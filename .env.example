# Copy to .env and fill in. .env is gitignored — never commit real keys.
#   cp .env.example .env
#
# Loaded automatically via `node --env-file-if-exists=.env`; no dotenv needed.
#
# Each provider accepts a MAFIA_-prefixed name OR the bare vendor name. The
# prefixed form is checked first and is recommended: some managed execution
# environments reserve bare vendor variables for their own authentication. It
# also makes it unambiguous which credential a run used.
#
# Every key is optional. `mafia providers` shows what is currently reachable.

# --- native adapters -------------------------------------------------------
MAFIA_ANTHROPIC_API_KEY=
MAFIA_OPENAI_API_KEY=
MAFIA_GEMINI_API_KEY=

# --- OpenAI-compatible adapters -------------------------------------------
# Fireworks covers the open-weight tail: DeepSeek, Kimi, GLM, Qwen, Llama.
MAFIA_FIREWORKS_API_KEY=
# xAI (Grok) and NVIDIA NIM (Nemotron) are also OpenAI-compatible.
MAFIA_XAI_API_KEY=
MAFIA_NVIDIA_API_KEY=

# --- optional --------------------------------------------------------------
# Base URL overrides, only if pointing at a proxy or gateway.
# ANTHROPIC_BASE_URL=
# OPENAI_BASE_URL=
